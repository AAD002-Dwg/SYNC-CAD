<Window x:Class="CadSyncInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SYNC-CAD · Gestor de Instalación"
        Height="520" Width="640"
        MinHeight="520" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        ResizeMode="NoResize"
        AllowsTransparency="False">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="110"/>
            <!-- Cuerpo contenido -->
            <RowDefinition Height="*"/>
            <!-- Footer barra inferior -->
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════════════════
             HEADER PREMIUM
        ════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}">

            <!-- Línea decorativa inferior del header -->
            <Border.Effect>
                <DropShadowEffect Color="#0284C7" BlurRadius="20" ShadowDepth="4" Opacity="0.4"/>
            </Border.Effect>

            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo / Badge icono -->
                <Border Grid.Column="0"
                        Width="52" Height="52"
                        CornerRadius="12"
                        VerticalAlignment="Center"
                        Margin="0,0,18,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0EA5E9" Offset="0"/>
                            <GradientStop Color="#38BDF8" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#38BDF8" BlurRadius="18" ShadowDepth="0" Opacity="0.6"/>
                    </Border.Effect>
                    <!-- Icono de sincronización (flechas giratorias) con Unicode -->
                    <TextBlock Text="⟳" FontSize="28" FontWeight="Bold"
                               Foreground="#08111F"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,2,0,0"/>
                </Border>

                <!-- Título y subtítulo -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SYNC"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="White"
                                   VerticalAlignment="Bottom"/>
                        <TextBlock Text="-CAD"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Bottom"/>
                        <TextBlock Text="  INSTALLER"
                                   FontSize="16" FontWeight="Light"
                                   Foreground="#7DD3FC"
                                   VerticalAlignment="Bottom"
                                   Margin="4,0,0,2"/>
                    </StackPanel>
                    <TextBlock Text="Complemento para AutoCAD 2022 / 2025 / 2027"
                               FontSize="12"
                               Foreground="#7DD3FC"
                               Opacity="0.8"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Badge de versión -->
                <Border Grid.Column="2"
                        Background="#0F2744"
                        BorderBrush="#1E4D80"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,5"
                        VerticalAlignment="Center">
                    <TextBlock Text="v1.3.2"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════
             CUERPO PRINCIPAL
        ════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{StaticResource BgPanelBrush}"
                Margin="0">
            <Grid Margin="28,24,28,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Separador -->
                    <RowDefinition Height="1"/>
                    <!-- Estado -->
                    <RowDefinition Height="Auto"/>
                    <!-- Progreso -->
                    <RowDefinition Height="Auto"/>
                    <!-- Mensaje de finalización -->
                    <RowDefinition Height="Auto"/>
                    <!-- Spacer -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Info del plugin instalado -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icono de la aplicación con indicador de estado como círculo -->
                    <Border Grid.Column="0"
                            Width="44" Height="44"
                            CornerRadius="10"
                            Background="{StaticResource BgCard2Brush}"
                            Margin="0,0,16,0">
                        <TextBlock Text="🔌" FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="CadSync Plugin"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Autodesk Application Plugins"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Badge instalado/no instalado -->
                    <Border Grid.Column="2" CornerRadius="20" Padding="12,4" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                        <Setter Property="Background" Value="#052E16"/>
                                        <Setter Property="BorderBrush" Value="#166534"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                        <Setter Property="Background" Value="#2D1B00"/>
                                        <Setter Property="BorderBrush" Value="#78350F"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="11" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                            <Setter Property="Text" Value="● INSTALADO"/>
                                            <Setter Property="Foreground" Value="#34D399"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                            <Setter Property="Text" Value="○ NO INSTALADO"/>
                                            <Setter Property="Foreground" Value="#FBBF24"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>

                <!-- Separador -->
                <Rectangle Grid.Row="1" Fill="{StaticResource SeparatorBrush}" Height="1" Margin="0,0,0,20"/>

                <!-- Área de estado -->
                <StackPanel Grid.Row="2" Margin="0,0,0,0">
                    <TextBlock Text="ESTADO DE LA OPERACIÓN"
                               FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,8"/>

                    <!-- Fila de icono de estado + texto -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Punto de color de estado -->
                        <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                                VerticalAlignment="Center" Margin="0,0,12,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource TextMutedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource ErrorBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusMessage}"
                                   FontSize="14" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Caja de ayuda en caso de error -->
                    <Border Margin="0,14,0,0"
                            Background="#200A0A" BorderBrush="#7F1D1D"
                            BorderThickness="1" CornerRadius="6" Padding="14,10"
                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Foreground="#FCA5A5" FontSize="12" TextWrapping="Wrap">
                            Asegúrate de que AutoCAD esté completamente cerrado antes de instalar.
                            Si el error persiste, verifica que 'CadSync.bundle' esté junto al ejecutable.
                        </TextBlock>
                    </Border>
                </StackPanel>

                <!-- ─── Barra de progreso ─── -->
                <StackPanel Grid.Row="3"
                            Margin="0,22,0,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Progreso"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock HorizontalAlignment="Right"
                                   FontSize="11"
                                   Foreground="{StaticResource AccentBrush}">
                            <TextBlock.Text>
                                <Binding Path="ProgressValue" StringFormat="{}{0:0}%"/>
                            </TextBlock.Text>
                        </TextBlock>
                    </Grid>
                    <ProgressBar Style="{StaticResource PremiumProgressBar}"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding ProgressValue}"/>
                </StackPanel>

                <!-- ─── Estado "Completado" ─── -->
                <Border Grid.Row="4"
                        Margin="0,22,0,0"
                        Background="#031A10" BorderBrush="#166534"
                        BorderThickness="1" CornerRadius="8" Padding="18,12"
                        Visibility="{Binding IsComplete, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="Operación completada con éxito"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="Reinicia AutoCAD para aplicar los cambios."
                                       FontSize="11"
                                       Foreground="#86EFAC"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════
             FOOTER DE ACCIONES
        ════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="#0C1A2E"
                BorderBrush="{StaticResource SeparatorBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="28,0">
                <!-- Texto de copyright -->
                <TextBlock Text="AAD002 Studio · SYNC-CAD v1.3.2"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center"/>

                <!-- Botones de acción -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <!-- DESINSTALAR (solo si está instalado) -->
                    <Button Content="Desinstalar"
                            Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding UninstallCommand}"
                            Margin="0,0,12,0"
                            Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <!-- SALIR (solo al finalizar) -->
                    <Button Content="Cerrar"
                            Style="{StaticResource NeutralButtonStyle}"
                            Command="{Binding CloseCommand}"
                            Margin="0,0,12,0"
                            Visibility="{Binding IsComplete, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <!-- INSTALAR (botón principal) -->
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding InstallCommand}"
                            Visibility="{Binding IsNotComplete, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Instalar ahora" VerticalAlignment="Center"/>
                            <TextBlock Text=" →" VerticalAlignment="Center" FontWeight="Light"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
