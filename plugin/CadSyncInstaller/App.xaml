<Application x:Class="CadSyncInstaller.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- ═══════════════════════════════════════════════
             PALETA SYNC-CAD
        ═══════════════════════════════════════════════ -->
        <SolidColorBrush x:Key="BgDarkBrush"      Color="#080F1A"/>
        <SolidColorBrush x:Key="BgPanelBrush"     Color="#101828"/>
        <SolidColorBrush x:Key="BgCardBrush"      Color="#192133"/>
        <SolidColorBrush x:Key="BgCard2Brush"     Color="#1E2D42"/>
        <SolidColorBrush x:Key="AccentBrush"      Color="#38BDF8"/>
        <SolidColorBrush x:Key="AccentDarkBrush"  Color="#0284C7"/>
        <SolidColorBrush x:Key="AccentGlowBrush"  Color="#0EA5E9"/>
        <SolidColorBrush x:Key="SuccessBrush"     Color="#34D399"/>
        <SolidColorBrush x:Key="WarningBrush"     Color="#FBBF24"/>
        <SolidColorBrush x:Key="ErrorBrush"       Color="#F87171"/>
        <SolidColorBrush x:Key="TextBrush"        Color="#F1F5F9"/>
        <SolidColorBrush x:Key="TextMutedBrush"   Color="#64748B"/>
        <SolidColorBrush x:Key="SeparatorBrush"   Color="#1E3A5F"/>
        <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>

        <!-- ═══════════════════════════════════════════════
             GRADIENTES
        ═══════════════════════════════════════════════ -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0C2340" Offset="0"/>
            <GradientStop Color="#0F3460" Offset="0.5"/>
            <GradientStop Color="#0284C7" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentButtonGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0EA5E9" Offset="0"/>
            <GradientStop Color="#38BDF8" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentButtonHoverGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0284C7" Offset="0"/>
            <GradientStop Color="#0EA5E9" Offset="1"/>
        </LinearGradientBrush>

        <!-- ═══════════════════════════════════════════════
             TIPOGRAFÍA BASE
        ═══════════════════════════════════════════════ -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
        </Style>

        <!-- ═══════════════════════════════════════════════
             BOTÓN PRIMARIO (Instalar)
        ═══════════════════════════════════════════════ -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="FontFamily"   Value="Segoe UI"/>
            <Setter Property="FontSize"     Value="14"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="#0A1628"/>
            <Setter Property="Padding"      Value="28,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{StaticResource AccentButtonGradient}"
                                CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect Color="#0284C7" BlurRadius="16" ShadowDepth="0" Opacity="0.5"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{StaticResource AccentButtonHoverGradient}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background" Value="#1E2D42"/>
                                <Setter Property="Foreground" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════
             BOTÓN PELIGRO GHOST (Desinstalar)
        ═══════════════════════════════════════════════ -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Foreground"      Value="#F87171"/>
            <Setter Property="Padding"         Value="20,11"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="8"
                                BorderBrush="#F87171" BorderThickness="1"
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1A1015"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#334155"/>
                                <Setter Property="Foreground" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════
             BOTÓN NEUTRO (Salir)
        ═══════════════════════════════════════════════ -->
        <Style x:Key="NeutralButtonStyle" TargetType="Button">
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Foreground"      Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Padding"         Value="20,11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="8" Background="#1E2D42">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#253145"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════
             PROGRESSBAR CUSTOM
        ═══════════════════════════════════════════════ -->
        <Style x:Key="PremiumProgressBar" TargetType="ProgressBar">
            <Setter Property="Height"          Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="#1E2D42"/>
            <Setter Property="Foreground"      Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border CornerRadius="3" Background="{TemplateBinding Background}">
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    CornerRadius="3">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#0EA5E9" Offset="0"/>
                                        <GradientStop Color="#38BDF8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#38BDF8" BlurRadius="8"
                                                      ShadowDepth="0" Opacity="0.7"/>
                                </Border.Effect>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
