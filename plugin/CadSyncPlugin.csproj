<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyName>CadSyncPlugin</AssemblyName>
    <RootNamespace>CadSyncPlugin</RootNamespace>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <!-- Rutas de AutoCAD por Versión -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <AcadPath>C:\Program Files\Autodesk\AutoCAD 2022</AcadPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <AcadPath>C:\Program Files\Autodesk CAD1\AutoCAD 2025</AcadPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <AcadPath>C:\Program Files\Autodesk\AutoCAD 2027</AcadPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="accoremgd">
      <HintPath>$(AcadPath)\accoremgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(AcadPath)\acdbmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>$(AcadPath)\acmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acwindows">
      <HintPath>$(AcadPath)\acwindows.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="adwindows">
      <HintPath>$(AcadPath)\adwindows.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="SocketIOClient" Version="3.1.1" />
    <PackageReference Include="SocketIOClient.Newtonsoft.Json" Version="3.0.7" />
  </ItemGroup>
</Project>
