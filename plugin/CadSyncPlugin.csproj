<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyName>CadSyncPlugin</AssemblyName>
    <RootNamespace>CadSyncPlugin</RootNamespace>
    <Platforms>x64</Platforms>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- Definición de Constantes por Versión -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <AcadVersion>2025</AcadVersion>
    <DefineConstants>TRACE;ACAD2025</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <AcadVersion>2027</AcadVersion>
    <DefineConstants>TRACE;ACAD2027</DefineConstants>
  </PropertyGroup>

  <!-- Referencias para AutoCAD Versiones Modernas (NuGet) -->
  <!-- Esto permite la compilación en la Nube (CI/CD GitHub Actions) sin tener AutoCAD instalado -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows' Or '$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="AutoCAD.NET" Version="25.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="SocketIOClient" Version="3.1.1" />
    <PackageReference Include="SocketIOClient.Newtonsoft.Json" Version="3.0.7" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="CadSyncInstaller\**" />
    <EmbeddedResource Remove="CadSyncInstaller\**" />
    <None Remove="CadSyncInstaller\**" />
  </ItemGroup>
</Project>
