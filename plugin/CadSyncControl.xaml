<UserControl x:Class="CadSyncPlugin.CadSyncControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="280"
             FontFamily="Segoe UI"
             Background="{DynamicResource BgMain}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <SolidColorBrush x:Key="BgHeader"      Color="#383838"/>
        <SolidColorBrush x:Key="BgLabel"       Color="#323232"/>
        <SolidColorBrush x:Key="Separator"     Color="#3F3F3F"/>
        
        <!-- ── Slim ScrollBar Style ── -->
        <Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="rectangle" Background="#555" CornerRadius="1" Margin="2,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="rectangle" Property="Background" Value="#888" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Property Grid Style ── -->
        <Style x:Key="PropertyRow" TargetType="Grid">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
        </Style>
        
        <Style x:Key="LabelCell" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgLabel}"/>
            <Setter Property="Padding" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="ValueCell" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgTertiary}"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="PropertyLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ── Native Expander Style ── -->
        <Style TargetType="Expander">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderToggleButton"
                                          Background="{DynamicResource BgHeader}"
                                          BorderBrush="{DynamicResource BorderColor}"
                                          BorderThickness="0,0,0,1"
                                          MinHeight="22"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid Margin="10,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" Data="M0,0 L4,4 L0,8 Z" Fill="{DynamicResource TextSecondary}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,8,0">
                                                    <Path.RenderTransform>
                                                        <RotateTransform x:Name="ArrowRotation" Angle="0" CenterX="2" CenterY="4"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Content="{Binding Content, RelativeSource={RelativeSource AncestorType=Expander}}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90" CenterX="2" CenterY="4"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <TextBlock Text="{TemplateBinding Header}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextMain}"/>
                            </ToggleButton>
                            <Border x:Name="ContentBorder" Visibility="{TemplateBinding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ContentPresenter Margin="0"/>
                            </Border>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ToolBtn Style (Toolbar) ── -->
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgTertiary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Flat Control Styles ── -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="2,0"/>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Native-style Toolbar -->
            <RowDefinition Height="32"/>
            <!-- Scrollable body -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════
             NATIVE TOOLBAR: Sync · Pull · Refresh · Settings
             ═══════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgHeader}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="6,0" LastChildFill="True">
                
                <TextBlock DockPanel.Dock="Left" Text="SYNC PAD" VerticalAlignment="Center" 
                           Foreground="{DynamicResource TextSecondary}" FontWeight="Bold" 
                           FontSize="10" Margin="4,0,10,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ToolBtn}" ToolTip="Refrescar lista" Click="BtnRefreshFiles_Click">
                        <TextBlock Text="↺" FontSize="14" Foreground="{DynamicResource TextMain}"/>
                    </Button>
                    <Separator Width="1" Margin="4,6" Background="{DynamicResource Separator}"/>
                    <Button Style="{StaticResource ToolBtn}" ToolTip="Bajar capas remotas" Click="BtnPull_Click">
                        <TextBlock Text="⬇" FontSize="14" Foreground="{DynamicResource TextMain}"/>
                    </Button>
                    <Button Style="{StaticResource ToolBtn}" ToolTip="Sincronizar capas activas" Click="BtnPushDelta_Click">
                        <TextBlock Text="⬆" FontSize="14" Foreground="{DynamicResource SuccessColor}"/>
                    </Button>
                    <Separator Width="1" Margin="4,6" Background="{DynamicResource Separator}"/>
                    <Button x:Name="BtnTheme" Style="{StaticResource ToolBtn}" ToolTip="Cambiar tema" Click="BtnTheme_Click">
                        <TextBlock x:Name="ThemeIcon" Text="☀" FontSize="14" Foreground="{DynamicResource TextMain}"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════
             NATIVE BODY (Expanders + Grid)
             ═══════════════════════════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource BgMain}">
            <StackPanel>
                
                <!-- ── Sección General / Autenticación ── -->
                <Expander Header="CONFIGURACIÓN">
                    <StackPanel Background="{DynamicResource BgMain}">
                        <Grid Style="{StaticResource PropertyRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource LabelCell}">
                                <TextBlock Text="Studio Key" Style="{StaticResource PropertyLabel}"/>
                            </Border>
                            <Border Style="{StaticResource ValueCell}">
                                <TextBox x:Name="TxtStudioKey" SelectionBrush="{DynamicResource AccentColor}"/>
                            </Border>
                        </Grid>
                        
                        <Grid Style="{StaticResource PropertyRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource LabelCell}">
                                <TextBlock Text="Desktop Token" Style="{StaticResource PropertyLabel}"/>
                            </Border>
                            <Border Style="{StaticResource ValueCell}">
                                <TextBox x:Name="TxtDesktopToken" FontSize="9"/>
                            </Border>
                        </Grid>

                        <Grid Height="30" Margin="0,5">
                            <Button Content="APLICAR CREDENCIALES" Margin="5,0" 
                                    Style="{StaticResource PrimaryBtn}" 
                                    Click="BtnSaveToken_Click"/>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- ── Sección Capas Activas ── -->
                <Expander Header="CAPAS EN TRABAJO">
                    <StackPanel Background="{DynamicResource BgMain}">
                        
                        <Grid Style="{StaticResource PropertyRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource LabelCell}">
                                <TextBlock Text="Auto-Subida" Style="{StaticResource PropertyLabel}"/>
                            </Border>
                            <Border Style="{StaticResource ValueCell}">
                                <CheckBox x:Name="ChkAutoPush" VerticalAlignment="Center" 
                                          Checked="ChkAuto_Changed" Unchecked="ChkAuto_Changed"/>
                            </Border>
                        </Grid>

                        <Grid Style="{StaticResource PropertyRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource LabelCell}">
                                <TextBlock Text="Auto-Sinc" Style="{StaticResource PropertyLabel}"/>
                            </Border>
                            <Border Style="{StaticResource ValueCell}">
                                <CheckBox x:Name="ChkAutoPull" VerticalAlignment="Center"
                                          Checked="ChkAuto_Changed" Unchecked="ChkAuto_Changed"/>
                            </Border>
                        </Grid>

                        <!-- Active context list -->
                        <ItemsControl x:Name="ActiveLayersList" Margin="0,1,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Style="{StaticResource PropertyRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource LabelCell}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Margin="0,0,6,0">
                                                    <Ellipse.Fill>
                                                        <SolidColorBrush Color="{Binding StatusDotColor}"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource PropertyLabel}" MaxWidth="80" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource ValueCell}">
                                            <TextBlock Text="{Binding StatusText}" FontSize="9" Foreground="{Binding BadgeFg}" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="TxtNoLayers" Text="Sin capas modificadas localmente"
                                   FontSize="10" FontStyle="Italic" Foreground="{DynamicResource TextHint}"
                                   HorizontalAlignment="Center" Margin="0,10" Visibility="Visible"/>
                    </StackPanel>
                </Expander>

                <!-- ── Sección Colaboración ── -->
                <Expander Header="EQUIPO EN VIVO">
                    <StackPanel Background="{DynamicResource BgMain}">
                        <Grid Style="{StaticResource PropertyRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource LabelCell}">
                                <TextBlock Text="Ver Cursores" Style="{StaticResource PropertyLabel}"/>
                            </Border>
                            <Border Style="{StaticResource ValueCell}">
                                <CheckBox x:Name="ChkGhostCursors" VerticalAlignment="Center"
                                          Checked="ChkGhostCursors_Changed" Unchecked="ChkGhostCursors_Changed"/>
                            </Border>
                        </Grid>

                        <ItemsControl x:Name="ConnectedUsersList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Style="{StaticResource PropertyRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource LabelCell}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="{Binding ColorBrush}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource PropertyLabel}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource ValueCell}">
                                            <TextBlock Text="Online" FontSize="9" Foreground="{DynamicResource SuccessColor}" VerticalAlignment="Center"/>
                                        </Border>
                                        <Button Grid.Column="2" Tag="{Binding Name}" Click="BtnJumpToUser_Click" 
                                                Style="{StaticResource ToolBtn}" Width="20" Height="20">
                                            <TextBlock Text="📍" FontSize="10"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="TxtNoUsers" Text="Solo tú estás conectado"
                                   FontSize="10" FontStyle="Italic" Foreground="{DynamicResource TextHint}"
                                   HorizontalAlignment="Center" Margin="0,10" Visibility="Visible"/>
                    </StackPanel>
                </Expander>

                <!-- ── Sección Historial / Logs ── -->
                <Expander Header="ACTIVIDAD" IsExpanded="False">
                    <Border Background="{DynamicResource BgDeep}" Height="150" Padding="5">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="LogList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Message}" FontSize="10" 
                                                   Foreground="{DynamicResource TextSecondary}" 
                                                   TextWrapping="Wrap" Margin="2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Expander>

                <!-- ── Sección Archivos Cloud ── -->
                <Expander Header="NUBE Y ARCHIVOS">
                    <StackPanel Background="{DynamicResource BgMain}">
                        <Grid Style="{StaticResource PropertyRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource LabelCell}">
                                <TextBlock Text="Archivo" Style="{StaticResource PropertyLabel}"/>
                            </Border>
                            <Border Style="{StaticResource ValueCell}">
                                <ComboBox x:Name="FileCombo" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="11"/>
                            </Border>
                        </Grid>

                        <Grid Height="34" Margin="5">
                            <Button Content="SUBIR PROYECTO COMPLETO" 
                                    Style="{StaticResource PrimaryBtn}" 
                                    Click="BtnSync_Click"/>
                        </Grid>
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
